# Required for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_notes
SESSION_SECRET=replace-with-a-long-random-local-secret
PORT=3000

# Seeded only when the users table is empty
ADMIN_EMAIL=turcotte@zukor.com
ADMIN_NAME=Sam
ADMIN_PASSWORD=replace-with-a-local-admin-password

# Optional integrations
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Stripe Payments + Invoicing (server only; never expose these to the browser)
# Prefer a least-privilege restricted key (rk_test_... / rk_live_...).
STRIPE_RESTRICTED_KEY=
# Temporary fallback only when a restricted key cannot cover the required API calls.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# JSON object keyed by your own stable offer slug. Price IDs remain server-side.
# Example: {"photo-notes-pro":{"price_id":"price_...","label":"Photo Notes Pro","dba":"Zukor AI"}}
STRIPE_CHECKOUT_OFFERS_JSON={}
# Optional stable tracking label; use 8+ letters/numbers, dashes, or underscores.
STRIPE_INTEGRATION_IDENTIFIER=photo_notes_zukorai1

# Optional runtime settings
PGSSL=
UPLOAD_DIR=./uploads
NODE_ENV=development

# One-time recovery only. Leave blank during normal operation.
ADMIN_PASSWORD_RESET=
