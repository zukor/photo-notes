# Required for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_notes
SESSION_SECRET=replace-with-a-long-random-local-secret
PORT=3000

# Seeded only when the users table is empty
ADMIN_EMAIL=turcotte@zukor.com
ADMIN_NAME=Sam
ADMIN_PASSWORD=replace-with-a-local-admin-password

# Optional integrations
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Optional runtime settings
PGSSL=
UPLOAD_DIR=./uploads
NODE_ENV=development

# One-time recovery only. Leave blank during normal operation.
ADMIN_PASSWORD_RESET=
