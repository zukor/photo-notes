# Copy to .env for local dev. On Railway these are set as service variables.
DATABASE_URL=postgres://user:pass@localhost:5432/efc
ADMIN_PASSWORD=change-me
SESSION_SECRET=some-long-random-string
UPLOAD_DIR=./uploads
PORT=3000

# Pro AI features (defect classification, measure-from-photo). Without this key
# those features soft-fail and records still save normally.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override for the vision model id (defaults to claude-sonnet-4-6).
VISION_MODEL=claude-sonnet-4-6

# Optional. A Mapbox public token (starts pk.) enables accurate US addresses and
# Mapbox satellite map tiles. Without it, addresses use free OpenStreetMap and
# the map falls back to Esri World Imagery.
MAPBOX_TOKEN=pk....
